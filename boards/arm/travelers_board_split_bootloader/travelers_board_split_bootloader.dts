/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "travelers-board-split Bootloader variant (NINA-B302-00B)";
    compatible = "travelers-board-split-bootloader";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,flash = &flash0;
        zephyr,sram = &sram0;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,battery = &vbat;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <6>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
                    RC(3,1)                 RC(3,4) RC(3,5)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        row-gpios = <
            &gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
            &gpio0 25 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
        >;
        col-gpios = <
            &gpio0 19 GPIO_ACTIVE_HIGH
            &gpio0 17 GPIO_ACTIVE_HIGH
            &gpio0 20 GPIO_ACTIVE_HIGH
            &gpio0 22 GPIO_ACTIVE_HIGH
            &gpio0 21 GPIO_ACTIVE_HIGH
            &gpio0 23 GPIO_ACTIVE_HIGH
        >;
        diode-direction = "col2row";
    };

    vbat: battery {
        compatible = "zmk,power-gated-battery-voltage-divider";
        status = "okay";
        io-channels = <&adc 2>;
        output-ohms = <1000000>;
        full-ohms = <2000000>;
        power-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
        settle-delay-ms = <300>;
    };
};

&adc { status = "okay"; };
&gpiote { status = "okay"; };
&gpio0 { status = "okay"; };
&gpio1 { status = "okay"; };
&uart0 { status = "disabled"; };
&usbd { status = "okay"; };

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        mbr_partition: partition@0 {
            label = "mbr";
            reg = <0x00000000 0x00001000>;
            read-only;
        };

        s140_partition: partition@1000 {
            label = "s140";
            reg = <0x00001000 0x00026000>;
            read-only;
        };

        code_partition: partition@27000 {
            label = "code";
            reg = <0x00027000 0x000ad000>;
        };

        storage_partition: partition@d4000 {
            label = "storage";
            reg = <0x000d4000 0x00020000>;
        };

        bootloader_partition: partition@f4000 {
            label = "bootloader";
            reg = <0x000f4000 0x0000c000>;
            read-only;
        };
    };
};
